---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PEOPLE, SITE, serviceForFocus } from "../../data/content";
import { breadcrumbLd, personLd } from "../../lib/schema";

// Static detail pages backed by local content.
// When Sanity is connected, extend this with a single-person fetch.
export async function getStaticPaths() {
  return PEOPLE.map((p) => ({
    params: { slug: p.slug },
    props: { person: p },
  }));
}

const { person } = Astro.props;
// Keep the SERP title within ~60 chars: drop the role when the name is long.
const fullTitle = `${person.name} — ${person.title} | SBA Legal Consult`;
const pageTitle = fullTitle.length <= 60 ? fullTitle : `${person.name} | SBA Legal Consult`;
const others = PEOPLE.filter((p) => p.slug !== person.slug);

// Single shared art for every bio hero.
const heroImage = "/backgrounds/62.webp";
---
<BaseLayout
  title={pageTitle}
  description={person.excerpt ?? `${person.name}, ${person.title} at SBA Legal Consult in Kumasi, Ghana.`}
  ogImage={person.image}
  jsonLd={[
    personLd(person, Astro.site!),
    breadcrumbLd([["Home", "/"], ["Our People", "/people/"], [person.name, `/people/${person.slug}/`]], Astro.site!),
  ]}
>
  {/* Bio hero: background art with designation + name left, portrait right */}
  <section aria-label={`${person.name}, ${person.title}`} class="relative isolate overflow-hidden bg-[#EDEFF3]">
    <div class="absolute inset-0 -z-10">
      <img
        src={heroImage}
        width="1920"
        height="1200"
        alt=""
        aria-hidden="true"
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-white/70"></div>
    </div>

    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-20">
      <div>
        <a
          href="/people"
          class="inline-flex items-center gap-1 text-sm font-semibold text-[#07678F] hover:text-[#054A68]"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-4 w-4 rotate-180"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M7 17 17 7" />
            <path d="M8 7h9v9" />
          </svg>
          <span>Our People</span>
        </a>
        <p class="mt-6 t-eyebrow text-[#07678F]">
          {person.title}
        </p>
        <h1 class="font-display mt-3 max-w-2xl t-h1 text-[#16233A]">
          {person.name}
        </h1>
        {person.excerpt && (
          <p class="mt-4 max-w-xl t-body text-slate-600">
            {person.excerpt}
          </p>
        )}
      </div>

      <div class="justify-self-start lg:justify-self-end">
        <img
          src={person.image}
          width="900"
          height="1200"
          fetchpriority="high"
          alt={`Portrait of ${person.name}`}
          loading="eager"
          class="aspect-[3/4] w-72 object-cover shadow-xl sm:w-80"
        />
      </div>
    </div>
  </section>

  <section class="bg-white" aria-label={`Profile of ${person.name}`}>
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-16">
        <div class="scroll-reveal">
          <h2 class="t-eyebrow text-[#07678F]">Profile</h2>
          <div class="mt-6 max-w-2xl space-y-6 border-t border-[#D3E3EA] pt-8">
            {person.bio?.map((para: string, i: number) => (
              <p class={i === 0 ? "t-lead text-[#16233A]" : "t-body text-slate-600"}>{para}</p>
            ))}
          </div>
        </div>

        <div class="divide-y divide-[#D3E3EA] border-t border-[#D3E3EA] lg:border-t-0">
          {person.focus && person.focus.length > 0 && (
            <section class="scroll-reveal py-8 first:pt-0 lg:pt-0" aria-labelledby="expertise-h">
              <h2 id="expertise-h" class="t-eyebrow text-[#07678F]">Areas of expertise</h2>
              <ul class="mt-4 grid gap-3">
                {person.focus.map((f: string) => {
                  const service = serviceForFocus(f);
                  return (
                    <li class="flex gap-3 t-body">
                      <svg viewBox="0 0 24 24" class="mt-1.5 h-4 w-4 shrink-0 text-[#07678F]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
                      {service ? (
                        <a href={`/expertise/${service.slug}`} class="font-medium text-[#16233A] hover:text-[#07678F]">{f}</a>
                      ) : (
                        <span class="font-medium text-[#16233A]">{f}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
          {person.alumniOf && person.alumniOf.length > 0 && (
            <section class="scroll-reveal py-8" aria-labelledby="education-h">
              <h2 id="education-h" class="t-eyebrow text-[#07678F]">Education and training</h2>
              <ul class="mt-4 grid gap-3 t-body text-slate-600">
                {person.alumniOf.map((a: string) => <li>{a}</li>)}
              </ul>
            </section>
          )}
          {person.memberOf && person.memberOf.length > 0 && (
            <section class="scroll-reveal py-8" aria-labelledby="memberships-h">
              <h2 id="memberships-h" class="t-eyebrow text-[#07678F]">Memberships</h2>
              <ul class="mt-4 grid gap-3 t-body text-slate-600">
                {person.memberOf.map((m: string) => <li>{m}</li>)}
              </ul>
            </section>
          )}
          <section class="scroll-reveal py-8" aria-labelledby="contact-h">
            <h2 id="contact-h" class="t-eyebrow text-[#07678F]">Contact</h2>
            <a href={`mailto:${person.email ?? SITE.email}`} class="mt-4 inline-block break-words font-display t-h3 text-[#16233A] hover:text-[#07678F]">{person.email ?? SITE.email}</a>
          </section>
        </div>
      </div>

      <div class="mt-16 border-t border-[#D3E3EA] pt-10">
        <h2 class="font-display t-h2 text-[#16233A]">
          More of our team
        </h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {others.map((p) => (
            <a href={`/people/${p.slug}`} class="group block" aria-label={`View profile of ${p.name}`}>
              <div class="card-hover overflow-hidden">
                <img
                  src={p.image}
                  width="900"
                  height="1200"
                  alt={p.name}
                  loading="lazy"
                  class="aspect-[3/4] w-full object-cover"
                />
              </div>
              <div class="pt-3 text-left">
                <p class="text-sm font-semibold text-[#16233A] group-hover:text-[#07678F]">
                  {p.name}
                </p>
                <p class="text-xs text-slate-500">{p.title}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
