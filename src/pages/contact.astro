---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { PAGE_HERO_IMAGES, SITE } from "../data/content";

const DETAILS = [
  { label: "Email", value: SITE.email, href: `mailto:${SITE.email}` },
  { label: "Telephone", value: SITE.phone1, href: `tel:+233${SITE.phone1.substring(1)}` },
  { label: "Telephone", value: SITE.phone2, href: `tel:+233${SITE.phone2.substring(1)}` },
  { label: "Office", value: SITE.address },
];
---
<BaseLayout
  title="Contact | SBA Legal Consult"
  description="Contact SBA Legal Consult in Ahinsan Estate, Kumasi — email chambers@sbalegalconsult.com, call, message, or visit our offices."
>
  <PageHero
    title="Contact Us"
    images={PAGE_HERO_IMAGES}
  />

  <section class="bg-white" aria-labelledby="contact-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <h2 id="contact-heading" class="scroll-reveal font-display text-3xl font-semibold text-[#16233A]">
        Get in touch
      </h2>
      <p class="scroll-reveal mt-3 max-w-2xl text-base leading-relaxed text-slate-600">
        For all enquiries, email our chambers or call the office. We will respond
        as promptly as possible.
      </p>
      <dl class="stagger-grid mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {DETAILS.map((d) => (
          <div class="border border-[#D9E1F0] bg-[#F4F6FA] p-6">
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[#0F3D8E]">{d.label}</dt>
            <dd class="mt-3 text-sm leading-relaxed text-[#16233A] break-words">
              {d.href ? <a href={d.href} class="font-semibold hover:text-[#0F3D8E]">{d.value}</a> : d.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
