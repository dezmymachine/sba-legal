---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleBody from "../../components/ArticleBody.astro";
import {
  getAllArticleSlugs,
  getArticle,
  getArticlesByKind,
  getArticles,
  formatDate,
  KIND_LABELS,
} from "../../lib/sanity";
import { articleLd, breadcrumbLd } from "../../lib/schema";
import { PEOPLE, SERVICES, serviceForFocus } from "../../data/content";

// Static detail pages backed by local content today, Sanity tomorrow:
// slugs come from Sanity when credentials are set, mocks otherwise.
export async function getStaticPaths() {
  const slugs = await getAllArticleSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await getArticle(slug);

if (!article) {
  return Astro.redirect("/knowledge");
}

const label = KIND_LABELS[article.kind].singular;

// Recommended: same kind first, then the rest — never the current item.
const sameKind = (await getArticlesByKind(article.kind)).filter((a) => a.slug !== article.slug);
const latest = (await getArticles()).filter(
  (a) => a.slug !== article.slug && !sameKind.some((s) => s.slug === a.slug)
);
const recommended = [...sameKind, ...latest].slice(0, 3);

const authorFocus = PEOPLE.find((p) => p.slug === article.author?.slug)?.focus ?? [];
const relatedServices = [...new Set(authorFocus.map(serviceForFocus).filter(Boolean))] as typeof SERVICES;
// Long headlines already fill the ~60-char SERP title; skip the brand suffix then.
const title = article.seoTitle ?? (article.title.length > 45 ? article.title : `${article.title} | SBA Legal Consult`);
---
<BaseLayout
  title={title}
  description={article.seoDescription ?? article.excerpt ?? article.title}
  ogImage={article.heroImage ?? "/og-default.jpg"}
  ogType="article"
  publishedTime={article.date}
  ogImageAlt={article.title}
  jsonLd={[
    articleLd(article, Astro.site!),
    breadcrumbLd([["Home", "/"], ["Knowledge Centre", "/knowledge/"], [article.title, `/knowledge/${article.slug}/`]], Astro.site!),
  ]}
>
  {/* Detail hero: article art with dark veil, kind eyebrow + white title */}
  <section aria-label={article.title} class="relative isolate overflow-hidden bg-[#16233A]">
    {article.heroImage && (
      <div class="absolute inset-0 -z-10">
        <img
          src={article.heroImage}
          width="1800"
          height="1000"
          fetchpriority="high"
          alt=""
          aria-hidden="true"
          loading="eager"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/55"></div>
      </div>
    )}
    <div class="mx-auto flex min-h-[52vh] max-w-7xl flex-col justify-center px-4 py-20 sm:px-6">
      <p class="text-sm font-medium text-white/85">{label}</p>
      <h1 class="font-display mt-3 max-w-3xl t-h1 text-white">
        {article.title}
      </h1>
      <p class="mt-4 text-sm text-white/75">
        {article.author && (
          <>By <a href={`/people/${article.author.slug}/`} class="font-medium underline underline-offset-2 hover:text-white">{article.author.name}</a>, {article.author.title} · </>
        )}
        <time datetime={article.date}>{formatDate(article.date)}</time>
      </p>
    </div>
  </section>

  <section class="bg-white" aria-label="Article content">
    <div class="mx-auto max-w-7xl px-5 py-12 sm:px-6 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px]">
        {/* min-w-0: wide content (tables) scrolls inside the column, not the page */}
        <div class="min-w-0">
          <ArticleBody body={article.body} />
          <a
            href="/knowledge"
            class="mt-10 inline-flex items-center gap-1 text-sm font-semibold text-[#07678F] hover:text-[#054A68]"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4 rotate-180"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M7 17 17 7" />
              <path d="M8 7h9v9" />
            </svg>
            <span>Back to Knowledge Centre</span>
          </a>
          {relatedServices.length > 0 && (
            <p class="mt-8 text-sm text-slate-600">
              Related practice {relatedServices.length > 1 ? "areas" : "area"}:
              {relatedServices.map((s, i) => (
                <>{i > 0 ? ", " : " "}<a href={`/expertise/${s.slug}/`} class="font-medium text-[#07678F] underline underline-offset-2">{s.title}</a></>
              ))}
            </p>
          )}
        </div>

        {/* Author sidebar — rendered only when an author is set (optional for events) */}
        {article.author && (
          <aside aria-label={`Author: ${article.author.name}`}>
            <h2 class="font-display text-center t-h3 text-[#16233A]">Author</h2>
            <a href={`/people/${article.author.slug}`} class="group mt-4 block">
              {article.author.image && (
                <div class="overflow-hidden">
                  <img
                    src={article.author.image}
                    width="480"
                    height="640"
                    alt={`Portrait of ${article.author.name}`}
                    loading="lazy"
                    class="mx-auto aspect-[3/4] w-36 object-cover sm:w-40"
                  />
                </div>
              )}
              <p class="mt-3 text-center text-sm font-semibold text-[#16233A] group-hover:text-[#07678F]">
                {article.author.name}
              </p>
              <p class="text-center text-sm text-slate-600">{article.author.title}</p>
            </a>
          </aside>
        )}
      </div>

      {/* Recommended content */}
      {recommended.length > 0 && (
        <div class="mt-16">
          <h2 class="font-display t-h2 text-[#16233A]">Recommended Content</h2>
          <div class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {recommended.map((r) => (
              <a href={`/knowledge/${r.slug}`} class="group block" aria-label={`Read: ${r.title}`}>
                {r.heroImage && (
                  <div class="card-hover overflow-hidden">
                    <img
                      src={r.heroImage}
                      width="1800"
                      height="1000"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="aspect-[16/10] w-full object-cover"
                    />
                  </div>
                )}
                <p class="mt-3 t-card text-[#16233A] group-hover:text-[#07678F]">
                  {r.title}
                </p>
                <p class="mt-2 text-sm text-slate-500">{formatDate(r.date)}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

