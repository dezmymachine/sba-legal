---
import BaseLayout from "../layouts/BaseLayout.astro";
import LearnMore from "../components/LearnMore.astro";
import { SERVICES } from "../data/content";
---
<BaseLayout
  title="Page not found | SBA Legal Consult"
  description="The page you were looking for could not be found."
  noindex
>
  <section class="bg-white" aria-labelledby="notfound-heading">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#0F3D8E]">404</p>
      <h1 id="notfound-heading" class="font-display mt-3 text-4xl font-medium text-[#16233A] sm:text-5xl">
        Page not found
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
        The page may have moved or no longer exists. Try one of our practice areas
        below, or contact our chambers directly.
      </p>
      <ul class="mt-10 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s) => (
          <li>
            <a href={`/expertise/${s.slug}`} class="text-sm font-medium text-[#16233A] hover:text-[#0F3D8E]">{s.title}</a>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap gap-8">
        <LearnMore href="/" label="Back to home" />
        <LearnMore href="/contact" label="Contact us" />
      </div>
    </div>
  </section>
</BaseLayout>
