---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import LearnMore from "../../components/LearnMore.astro";
import { PEOPLE, SERVICES, peopleForService } from "../../data/content";
import { breadcrumbLd, serviceLd } from "../../lib/schema";

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const matched = peopleForService(service);
// No one lists this area yet? Point to the Managing Partner, who leads every mandate.
const advisers = matched.length > 0 ? matched : PEOPLE.filter((p) => p.title === "Managing Partner");
const others = SERVICES.filter((s) => s.slug !== service.slug);
const path = `/expertise/${service.slug}/`;
const fullDescription = `${service.description} ${service.title} advice from SBA Legal Consult, Kumasi.`;
const description = fullDescription.length <= 160 ? fullDescription : service.description;
---
<BaseLayout
  title={`${service.title} | Law Firm in Kumasi, Ghana`}
  description={description}
  jsonLd={[
    serviceLd(service, Astro.site!),
    breadcrumbLd([["Home", "/"], ["Expertise", "/expertise/"], [service.title, path]], Astro.site!),
  ]}
>
  <PageHero title={service.title} eyebrow="Expertise" images={["/backgrounds/28337.webp"]} />

  <section class="bg-white" aria-labelledby="service-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-[#0F3D8E]">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/expertise" class="hover:text-[#0F3D8E]">Expertise</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-[#16233A]">{service.title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div class="min-w-0">
          <h2 id="service-heading" class="sr-only">About this practice area</h2>
          <p class="scroll-reveal text-lg leading-relaxed text-[#16233A]">
            {service.description}
          </p>
          {service.body?.map((para) => (
            <p class="mt-4 text-base leading-relaxed text-slate-600">{para}</p>
          ))}
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            SBA Legal Consult advises individuals, businesses and institutions from
            our offices in Ahinsan Estate, Kumasi, and acts for clients across Ghana.
          </p>
          <div class="mt-8 border border-[#D9E1F0] bg-[#F4F6FA] p-6">
            <p class="text-base text-[#16233A]">Need advice on {service.title}?</p>
            <div class="mt-3">
              <LearnMore href="/contact" label="Contact our chambers" />
            </div>
          </div>
        </div>

        <aside aria-labelledby="advisers-heading">
          <h2 id="advisers-heading" class="text-xs font-semibold uppercase tracking-[0.18em] text-[#0F3D8E]">
            {matched.length > 0 ? "Who advises" : "Speak to"}
          </h2>
          <ul class="mt-4 grid gap-4">
            {advisers.map((p) => (
              <li>
                <a href={`/people/${p.slug}`} class="group flex items-center gap-4">
                  <img
                    src={p.image}
                    alt={`Portrait of ${p.name}`}
                    width="56"
                    height="75"
                    loading="lazy"
                    class="aspect-[3/4] w-14 shrink-0 object-cover"
                  />
                  <span>
                    <span class="block text-sm font-semibold text-[#16233A] group-hover:text-[#0F3D8E]">{p.name}</span>
                    <span class="block text-xs text-slate-500">{p.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      </div>

      <div class="mt-16 border-t border-[#D9E1F0] pt-10">
        <h2 class="font-display text-2xl font-semibold text-[#16233A]">Other practice areas</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((s) => (
            <li>
              <a href={`/expertise/${s.slug}`} class="text-sm font-medium text-[#16233A] hover:text-[#0F3D8E]">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
