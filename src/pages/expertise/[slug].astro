---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import LearnMore from "../../components/LearnMore.astro";
import { SERVICES, SERVICE_FAQS } from "../../data/content";
import { getArticlesForService, formatDate, KIND_LABELS } from "../../lib/sanity";
import { breadcrumbLd, faqLd, serviceLd } from "../../lib/schema";

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const others = SERVICES.filter((s) => s.slug !== service.slug);
const path = `/expertise/${service.slug}/`;
const related = (await getArticlesForService(service)).slice(0, 3);
const faqs = SERVICE_FAQS[service.slug] ?? [];
const fullDescription = `${service.description} ${service.title} advice from SBA Legal Consult, Kumasi.`;
const description = fullDescription.length <= 160 ? fullDescription : service.description;
---
<BaseLayout
  title={`${service.title} | Law Firm in Kumasi, Ghana`}
  description={description}
  jsonLd={[
    serviceLd(service, Astro.site!),
    ...(faqs.length ? [faqLd(faqs, new URL(path, Astro.site!).toString())] : []),
    breadcrumbLd([["Home", "/"], ["Expertise", "/expertise/"], [service.title, path]], Astro.site!),
  ]}
>
  <PageHero title={service.title} eyebrow="Expertise" images={["/backgrounds/28337.webp"]} />

  <section class="bg-white" aria-labelledby="service-heading">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-6 lg:py-20">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-[#07678F]">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/expertise" class="hover:text-[#07678F]">Expertise</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-[#16233A]">{service.title}</li>
        </ol>
      </nav>

      <div class="mt-10">
        <div class="min-w-0">
          <h2 id="service-heading" class="sr-only">About this practice area</h2>
          <div class="prose-sba">
          <p class="scroll-reveal prose-lead">
            {service.description}
          </p>
          {service.body?.map((para) => (
            <p>{para}</p>
          ))}
          <p>
            SBA Legal Consult advises individuals, businesses and institutions from
            our offices in Ahinsan Estate, Kumasi, and acts for clients across Ghana.
          </p>
          </div>
          {faqs.length > 0 && (
            <div class="mt-14">
              <h2 class="font-display t-h2 text-[#16233A]">Frequently asked questions</h2>
              <div class="mt-6 border-b border-slate-400/70">
                {faqs.map((f) => (
                  <details class="faq group border-t border-slate-400/70">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-1 py-5 text-lg font-medium text-[#16233A] hover:text-[#07678F] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#07678F] sm:px-5 [&::-webkit-details-marker]:hidden">
                      <h3 class="font-medium">{f.q}</h3>
                      <span aria-hidden="true" class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
                    </summary>
                    <p class="max-w-[65ch] px-1 pb-6 text-[17px] leading-[1.75] text-slate-700 sm:px-5">{f.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )}
          <div class="mt-10">
            <p class="t-body text-[#16233A]">Need advice on {service.title}?</p>
            <a
              href="/contact"
              class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#07678F] px-6 py-3 t-small font-semibold text-white transition-colors hover:bg-[#054A68] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#07678F]"
            >
              Contact our chambers
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </div>
        </div>

      </div>

      {related.length > 0 && (
        <div class="mt-16 border-t border-[#D3E3EA] pt-10">
          <h2 class="font-display t-h2 text-[#16233A]">Related insights</h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => (
              <li>
                <a href={`/knowledge/${a.slug}/`} class="group block">
                  <p class="text-sm text-slate-500">{KIND_LABELS[a.kind].singular} · {formatDate(a.date)}</p>
                  <p class="mt-1 t-card text-[#16233A] group-hover:text-[#07678F]">{a.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-16 border-t border-[#D3E3EA] pt-10">
        <h2 class="font-display t-h2 text-[#16233A]">Other practice areas</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((s) => (
            <li>
              <a href={`/expertise/${s.slug}`} class="text-sm font-medium text-[#16233A] hover:text-[#07678F]">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
