---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import LearnMore from "../../components/LearnMore.astro";
import { SERVICES } from "../../data/content";
import { breadcrumbLd, serviceLd } from "../../lib/schema";

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const others = SERVICES.filter((s) => s.slug !== service.slug);
const path = `/expertise/${service.slug}/`;
const fullDescription = `${service.description} ${service.title} advice from SBA Legal Consult, Kumasi.`;
const description = fullDescription.length <= 160 ? fullDescription : service.description;
---
<BaseLayout
  title={`${service.title} | Law Firm in Kumasi, Ghana`}
  description={description}
  jsonLd={[
    serviceLd(service, Astro.site!),
    breadcrumbLd([["Home", "/"], ["Expertise", "/expertise/"], [service.title, path]], Astro.site!),
  ]}
>
  <PageHero title={service.title} eyebrow="Expertise" images={["/backgrounds/28337.webp"]} />

  <section class="bg-white" aria-labelledby="service-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-[#07678F]">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/expertise" class="hover:text-[#07678F]">Expertise</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-[#16233A]">{service.title}</li>
        </ol>
      </nav>

      <div class="mt-10">
        <div class="min-w-0 max-w-3xl">
          <h2 id="service-heading" class="sr-only">About this practice area</h2>
          <p class="scroll-reveal t-lead text-[#16233A]">
            {service.description}
          </p>
          {service.body?.map((para) => (
            <p class="mt-4 t-body text-slate-600">{para}</p>
          ))}
          <p class="mt-4 t-body text-slate-600">
            SBA Legal Consult advises individuals, businesses and institutions from
            our offices in Ahinsan Estate, Kumasi, and acts for clients across Ghana.
          </p>
          <div class="mt-10">
            <p class="t-body text-[#16233A]">Need advice on {service.title}?</p>
            <a
              href="/contact"
              class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#07678F] px-6 py-3 t-small font-semibold text-white transition-colors hover:bg-[#054A68] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#07678F]"
            >
              Contact our chambers
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </a>
          </div>
        </div>

      </div>

      <div class="mt-16 border-t border-[#D3E3EA] pt-10">
        <h2 class="font-display t-h2 text-[#16233A]">Other practice areas</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((s) => (
            <li>
              <a href={`/expertise/${s.slug}`} class="text-sm font-medium text-[#16233A] hover:text-[#07678F]">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
