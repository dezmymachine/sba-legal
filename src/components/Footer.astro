---
import { NAV_ITEMS, SITE, SERVICES } from "../data/content";
const SOCIAL_ICONS = {
  LinkedIn: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  Facebook: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  "X": "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
};
// "Firm" column: the nav pages (About Us children inline), minus Expertise (own column).
const firmLinks = NAV_ITEMS.flatMap((item) =>
  item.children ? item.children : [item]
).filter((l) => l.href !== "/expertise");
---
<footer aria-label="Footer" class="relative isolate overflow-hidden bg-[#16233A]">
  <img src="/images/hero-office.webp" alt="" aria-hidden="true" width="1920" height="1280" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-black/60"></div>

  <div class="mx-auto max-w-7xl px-3 pb-3 pt-24 sm:px-6 sm:pb-6 sm:pt-32">
    <div class="round-card flex flex-col bg-[#FDFDFA] px-6 py-10 sm:px-10 sm:py-12 lg:px-12">
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-[1fr_1.4fr_1.6fr]">
        <nav aria-label="Firm">
          <p class="t-body text-slate-400">Firm</p>
          <ul class="mt-3 grid gap-2">
            {firmLinks.map((l) => (
              <li><a href={l.href} class="t-body font-medium text-[#16233A] hover:text-[#07678F]">{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Expertise">
          <p class="t-body text-slate-400">Expertise</p>
          <ul class="mt-3 grid gap-2">
            {SERVICES.map((s) => (
              <li><a href={`/expertise/${s.slug}`} class="t-body font-medium text-[#16233A] hover:text-[#07678F]">{s.title}</a></li>
            ))}
          </ul>
        </nav>
        <div class="col-span-2 lg:col-span-1">
          <p class="t-body text-slate-400">Contact</p>
          <ul class="mt-3 grid gap-2 t-body font-medium text-[#16233A]">
            <li>{SITE.address}</li>
            <li><a href={`tel:${SITE.phone1}`} class="hover:text-[#07678F]">{SITE.phone1}</a></li>
            <li><a href={`tel:${SITE.phone2}`} class="hover:text-[#07678F]">{SITE.phone2}</a></li>
            <li><a href={`mailto:${SITE.email}`} class="break-words hover:text-[#07678F]">{SITE.email}</a></li>
          </ul>
          <div class="mt-8 overflow-hidden rounded-lg border border-[#D3E3EA]">
            <iframe
              title="SBA Legal Consult map — Ahinsan Estate, Kumasi"
              src="https://www.google.com/maps?q=Ahinsan+Estate+Kumasi+Ghana&output=embed"
              loading="lazy"
              class="h-44 w-full"
            ></iframe>
          </div>
          {/* Only real profiles (SITE.socials) are shown; hidden until the firm confirms them. */}
          {SITE.socials.length > 0 && (
            <>
              <p class="mt-8 t-body text-slate-400">Follow Us</p>
              <div class="mt-3 flex gap-4">
                {SITE.socials.map((s) => (
                  <a href={s.href} aria-label={s.label} rel="me noopener" target="_blank" class="text-[#16233A] hover:text-[#07678F]">
                    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={SOCIAL_ICONS[s.label]} /></svg>
                  </a>
                ))}
              </div>
            </>
          )}
        </div>
      </div>

      <div class="mt-16 flex flex-col gap-8 sm:mt-24 sm:flex-row sm:items-end sm:justify-between">
        <a href="/" aria-label="SBA Legal Consult home">
          <img src="/logo-mark.png" alt="" width="69" height="77" class="h-14 w-auto sm:h-20" />
        </a>
        <p class="t-small text-slate-400 sm:text-right">© 2026 SBA Legal Consult. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
