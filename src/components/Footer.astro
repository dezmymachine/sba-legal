---
import { NAV_ITEMS, SITE } from "../data/content";
---
<footer class="border-t border-[#D9E1F0] bg-white" aria-label="Footer">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-3">
    <div>
      <p class="text-sm font-semibold tracking-wide text-[#16233A]">{SITE.name.toUpperCase()}</p>
      <p class="mt-3 text-sm">{SITE.address}</p>
      <p class="mt-2 text-sm">Tel: {SITE.phone1}; {SITE.phone2}</p>
      <p class="mt-1 text-sm">Email: [TBC]</p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-2 text-sm">
        {NAV_ITEMS.map((item) => (
          <li><a href={item.href} class="text-slate-600 hover:text-[#0F3D8E]">{item.label}</a></li>
        ))}
       </ul>
       <div class="mt-4 flex gap-4">
         <a href="https://linkedin.com" aria-label="LinkedIn" class="text-slate-400 hover:text-[#0F3D8E]">
           <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
         </a>
         <a href="https://facebook.com" aria-label="Facebook" class="text-slate-400 hover:text-[#0F3D8E]">
           <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
         </a>
         <a href="https://x.com" aria-label="X" class="text-slate-400 hover:text-[#0F3D8E]">
           <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
         </a>
       </div>
     </nav>
    <div>
      <p class="text-sm font-semibold text-[#16233A]">Find us</p>
      <div class="mt-3 overflow-hidden border border-[#D9E1F0]">
        <iframe
          title="SBA Legal Consult map — Ahinsan Estate, Kumasi"
          src="https://www.google.com/maps?q=Ahinsan+Estate+Kumasi+Ghana&output=embed"
          loading="lazy"
          class="h-48 w-full"
        ></iframe>
      </div>
     </div>
  </div>
   <div class="border-t border-[#D9E1F0] py-4 text-center text-xs text-slate-500">
     © 2026 SBA Legal Consult. All rights reserved.
   </div>
</footer>
