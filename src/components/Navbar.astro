---
import { NAV_ITEMS } from "../data/content";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const groupActive = (item: (typeof NAV_ITEMS)[number]) =>
  item.children ? item.children.some((c) => isActive(c.href)) : isActive(item.href);
---
<header class="sticky top-0 z-50 border-b border-[#D3E3EA] bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center" aria-label="SBA Legal Consult home">
      <img src="/logo-mark.png" alt="SBA Legal Consult" width="69" height="77" class="h-11 w-auto" />
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {NAV_ITEMS.map((item) => item.children ? (
        <div class="nav-dropdown group relative" data-open="false">
          <button
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            class={`nav-dropdown-btn inline-flex items-center gap-1 text-sm font-medium transition-colors hover:text-[#07678F] ${groupActive(item) ? "text-[#07678F] underline underline-offset-8" : "text-slate-600"}`}
          >
            {item.label}
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180 group-data-[open=true]:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          {/* pt-3 bridges the gap so hover doesn't drop between button and panel */}
          <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-data-[open=true]:visible group-data-[open=true]:opacity-100">
            <ul class="min-w-48 rounded-lg border border-[#D3E3EA] bg-white py-2 shadow-lg">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    aria-current={isActive(child.href) ? "page" : undefined}
                    class={`block px-4 py-2 text-sm transition-colors hover:bg-slate-50 hover:text-[#07678F] ${isActive(child.href) ? "font-semibold text-[#07678F]" : "text-slate-600"}`}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class={`text-sm font-medium transition-colors hover:text-[#07678F] ${isActive(item.href) ? "text-[#07678F] underline underline-offset-8" : "text-slate-600"}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="lg:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        aria-haspopup="dialog"
        class="grid h-10 w-10 place-items-center text-[#07678F]"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Full-screen sheet; lives outside <header> because its backdrop-blur would trap position:fixed. */}
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  inert
  class="fixed inset-0 z-[60] flex translate-x-full flex-col bg-white transition-transform duration-300 ease-out motion-reduce:transition-none lg:hidden"
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-[#D3E3EA] px-4 sm:px-6">
    <a href="/" class="flex items-center" aria-label="SBA Legal Consult home">
      <img src="/logo-mark.png" alt="" width="69" height="77" class="h-11 w-auto" />
    </a>
    <button id="mobile-menu-close" type="button" aria-label="Close menu" class="grid h-10 w-10 place-items-center text-[#07678F]">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12" />
        <path d="M18 6 6 18" />
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-4 py-6 sm:px-6">
    <ul class="grid gap-1">
      {NAV_ITEMS.map((item) => (
        <li>
          {item.children ? (
            <>
              <p class="px-2 pb-1 pt-4 t-eyebrow text-[#07678F]">{item.label}</p>
              <ul class="grid gap-1 border-l border-[#D3E3EA] pl-3">
                {item.children.map((child) => (
                  <li><a href={child.href} aria-current={isActive(child.href) ? "page" : undefined} class={`block px-2 py-3 t-h3 font-medium hover:bg-slate-50 ${isActive(child.href) ? "text-[#07678F]" : "text-[#16233A]"}`}>{child.label}</a></li>
                ))}
              </ul>
            </>
          ) : (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class={`block px-2 py-3 t-h3 font-medium hover:bg-slate-50 ${isActive(item.href) ? "text-[#07678F]" : "text-[#16233A]"}`}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  function setOpen(open: boolean) {
    btn?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('translate-x-full', !open);
    menu?.classList.toggle('translate-x-0', open);
    if (menu) menu.inert = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : btn)?.focus();
  }
  btn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.inert) setOpen(false);
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches && menu && !menu.inert) setOpen(false);
  });

  // Desktop dropdowns: hover/focus open via CSS; click toggles for touch + keyboard.
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.nav-dropdown'));
  function setDropdown(dd: HTMLElement, open: boolean) {
    dd.dataset.open = String(open);
    dd.querySelector('.nav-dropdown-btn')?.setAttribute('aria-expanded', String(open));
  }
  dropdowns.forEach((dd) => {
    dd.querySelector('.nav-dropdown-btn')?.addEventListener('click', () => {
      setDropdown(dd, dd.dataset.open !== 'true');
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) setDropdown(dd, false);
    });
  });
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) setDropdown(dd, false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    dropdowns.forEach((dd) => {
      if (dd.dataset.open === 'true') {
        setDropdown(dd, false);
        (dd.querySelector('.nav-dropdown-btn') as HTMLElement | null)?.focus();
      }
    });
  });
</script>
