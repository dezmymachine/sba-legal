---
import { NAV_ITEMS } from "../data/content";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
const groupActive = (item: (typeof NAV_ITEMS)[number]) =>
  item.children ? item.children.some((c) => isActive(c.href)) : isActive(item.href);
---
<header class="sticky top-0 z-50 border-b border-[#D9E1F0] bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center text-[#0F3D8E]" aria-label="SBA Legal Consult home">
      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
        <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
        <path d="M7 21h10" />
        <path d="M12 3v18" />
        <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
      </svg>
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {NAV_ITEMS.map((item) => item.children ? (
        <div class="nav-dropdown group relative" data-open="false">
          <button
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
            class={`nav-dropdown-btn inline-flex items-center gap-1 text-sm font-medium transition-colors hover:text-[#0F3D8E] ${groupActive(item) ? "text-[#0F3D8E] underline underline-offset-8" : "text-slate-600"}`}
          >
            {item.label}
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180 group-data-[open=true]:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          {/* pt-3 bridges the gap so hover doesn't drop between button and panel */}
          <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-data-[open=true]:visible group-data-[open=true]:opacity-100">
            <ul class="min-w-48 border border-[#D9E1F0] bg-white py-2 shadow-lg">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    aria-current={isActive(child.href) ? "page" : undefined}
                    class={`block px-4 py-2 text-sm transition-colors hover:bg-[#F4F6FA] hover:text-[#0F3D8E] ${isActive(child.href) ? "font-semibold text-[#0F3D8E]" : "text-slate-600"}`}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class={`text-sm font-medium transition-colors hover:text-[#0F3D8E] ${isActive(item.href) ? "text-[#0F3D8E] underline underline-offset-8" : "text-slate-600"}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="lg:hidden">
      <button
        id="mobile-menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="grid h-10 w-10 place-items-center text-[#0F3D8E]"
      >
        <svg id="icon-open" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
        <svg id="icon-close" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12" />
          <path d="M18 6 6 18" />
        </svg>
      </button>
      <nav
        id="mobile-menu"
        class="pointer-events-none absolute inset-x-4 top-16 -translate-y-2 border border-[#D9E1F0] bg-white p-4 opacity-0 shadow-lg transition-all duration-300 ease-out"
        aria-label="Mobile"
      >
        <ul class="grid gap-1">
          {NAV_ITEMS.map((item) => (
            <li>
              {item.children ? (
                <>
                  <p class="px-2 pb-1 pt-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#0F3D8E]">{item.label}</p>
                  <ul class="grid gap-1 border-l border-[#D9E1F0] pl-3">
                    {item.children.map((child) => (
                      <li><a href={child.href} class="block px-2 py-2 text-sm text-slate-700 hover:bg-[#F4F6FA]">{child.label}</a></li>
                    ))}
                  </ul>
                </>
              ) : (
                <a href={item.href} class="block px-2 py-2 text-sm text-slate-700 hover:bg-[#F4F6FA]">{item.label}</a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  function setOpen(open: boolean) {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    menu?.classList.toggle('opacity-0', !open);
    menu?.classList.toggle('-translate-y-2', !open);
    menu?.classList.toggle('pointer-events-none', !open);
    menu?.classList.toggle('opacity-100', open);
    menu?.classList.toggle('translate-y-0', open);
  }
  let isOpen = false;
  btn?.addEventListener('click', () => {
    isOpen = !isOpen;
    setOpen(isOpen);
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    isOpen = false;
    setOpen(false);
  }));

  // Desktop dropdowns: hover/focus open via CSS; click toggles for touch + keyboard.
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.nav-dropdown'));
  function setDropdown(dd: HTMLElement, open: boolean) {
    dd.dataset.open = String(open);
    dd.querySelector('.nav-dropdown-btn')?.setAttribute('aria-expanded', String(open));
  }
  dropdowns.forEach((dd) => {
    dd.querySelector('.nav-dropdown-btn')?.addEventListener('click', () => {
      setDropdown(dd, dd.dataset.open !== 'true');
    });
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) setDropdown(dd, false);
    });
  });
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) setDropdown(dd, false);
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    dropdowns.forEach((dd) => {
      if (dd.dataset.open === 'true') {
        setDropdown(dd, false);
        (dd.querySelector('.nav-dropdown-btn') as HTMLElement | null)?.focus();
      }
    });
  });
</script>
