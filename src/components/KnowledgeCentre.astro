---
import { getArticles, formatDate, KIND_LABELS } from "../lib/sanity";
import LearnMore from "./LearnMore.astro";
const articles = await getArticles();
---

<section class="bg-white" aria-labelledby="knowledge-heading">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_2fr] lg:py-24"
  >
    <div>
      <h2
        id="knowledge-heading"
        class="scroll-reveal font-display text-3xl font-semibold text-[#16233A]"
      >
        Knowledge Centre
      </h2>
    </div>

    <div>
      <!-- stagger-grid: each article row cascades in -->
      <ul class="stagger-grid divide-y divide-[#D9E1F0] border-y border-[#D9E1F0]">
        {
          articles.map((a) => (
            <li>
              <a href={`/knowledge/${a.slug}`} class="group block py-4">
                <p class="text-xs">
                  <span class="font-semibold text-[#16233A]">{KIND_LABELS[a.kind].singular}</span>
                  <span class="mx-2 text-slate-300" aria-hidden="true">|</span>
                  <span class="text-slate-500">{formatDate(a.date)}</span>
                </p>
                <span class="mt-1 block text-[15px] font-medium text-[#16233A] group-hover:text-[#0F3D8E]">
                  {a.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex justify-end">
        <LearnMore href="/knowledge" />
      </div>
    </div>
  </div>
</section>
