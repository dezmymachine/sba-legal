---
// Renders Portable Text (Sanity) and the identically-shaped sample bodies with
// astro-portabletext. Site-specific pieces live in ./portable-text/.
import { PortableText } from "astro-portabletext";
import Block from "./portable-text/Block.astro";
import Mark from "./portable-text/Mark.astro";
import Image from "./portable-text/Image.astro";
import Table from "./portable-text/Table.astro";

interface Props {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  body?: any[];
}
const { body = [] } = Astro.props;
const components = { block: Block, mark: Mark, type: { image: Image, table: Table } };
---

<div class="article-body">
  <PortableText value={body} components={components} />
</div>

<style>
  /* Elements come from child components, so rules reach them via :global(). */
  .article-body {
    /* Same reading measure as .prose-sba (global.css); wide blocks opt out below. */
    max-width: 65ch;
    color: #3a4454;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.75;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }
  .article-body > :global(* + *) {
    margin-top: 1.5em;
  }
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.625rem);
    font-weight: 600;
    color: #16233a;
    padding-top: 0.5rem;
  }
  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    font-weight: 600;
    color: #16233a;
  }
  .article-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .article-body :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .article-body :global(li > ul),
  .article-body :global(li > ol),
  .article-body :global(li + li) {
    margin-top: 0.5rem;
  }
  .article-body :global(strong) {
    color: #16233a;
  }
  .article-body :global(a) {
    color: #07678F;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) {
    color: #054A68;
  }
  .article-body :global(code) {
    background: #F5F5F5;
    padding: 0.1rem 0.35rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
  }
  .article-body :global(blockquote) {
    border-left: 3px solid #07678F;
    padding-left: 1.25rem;
    font-style: italic;
    color: #16233a;
  }
  .article-body :global(.table-scroll) {
    overflow-x: auto;
    border: 1px solid #D3E3EA;
  }
  .article-body :global(table) {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.75rem 1rem;
    border-top: 1px solid #D3E3EA;
    text-align: left;
    vertical-align: top;
  }
  .article-body :global(thead th) {
    border-top: 0;
    background: #F5F5F5;
    color: #16233a;
    font-weight: 600;
  }
  .article-body :global(tbody th) {
    color: #16233a;
    font-weight: 600;
  }
  .article-body :global(figure img) {
    width: 100%;
    height: auto;
  }
</style>
