---
// Renders Portable Text blocks (Sanity) and the identically-shaped mock bodies.
// Supports: normal paragraphs, h2/h3, bullet + numbered lists, bold/italic marks.
interface Span {
  _type?: string;
  text?: string;
  marks?: string[];
}
interface Block {
  _type?: string;
  style?: string;
  listItem?: "bullet" | "number";
  children?: Span[];
}
interface Props {
  body?: Block[];
}
const { body = [] } = Astro.props;

function inline(children: Span[] = []): string {
  return children
    .map((c) => {
      const text = (c.text ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
      const marks = c.marks ?? [];
      if (marks.includes("strong") && marks.includes("em")) return `<strong><em>${text}</em></strong>`;
      if (marks.includes("strong")) return `<strong>${text}</strong>`;
      if (marks.includes("em")) return `<em>${text}</em>`;
      return text;
    })
    .join("");
}

type Node =
  | { type: "para"; html: string }
  | { type: "h2"; html: string }
  | { type: "h3"; html: string }
  | { type: "list"; ordered: boolean; items: string[] };

// Group consecutive list items so each list renders as one <ul>/<ol>.
const nodes: Node[] = [];
for (const b of body) {
  if (!b || b._type !== "block") continue;
  if (b.listItem === "bullet" || b.listItem === "number") {
    const ordered = b.listItem === "number";
    const last = nodes[nodes.length - 1];
    if (last && last.type === "list" && last.ordered === ordered) {
      last.items.push(inline(b.children));
    } else {
      nodes.push({ type: "list", ordered, items: [inline(b.children)] });
    }
    continue;
  }
  const html = inline(b.children);
  if (!html.trim()) continue;
  if (b.style === "h2") nodes.push({ type: "h2", html });
  else if (b.style === "h3") nodes.push({ type: "h3", html });
  else nodes.push({ type: "para", html });
}
---

<div class="article-body">
  {
    nodes.map((n) => {
      if (n.type === "h2")
        return <h2 set:html={n.html} />;
      if (n.type === "h3")
        return <h3 set:html={n.html} />;
      if (n.type === "list")
        return n.ordered ? (
          <ol>
            {n.items.map((item) => (
              <li set:html={item} />
            ))}
          </ol>
        ) : (
          <ul>
            {n.items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        );
      return <p set:html={n.html} />;
    })
  }
</div>

<style>
  .article-body {
    color: #3a4454;
    font-size: 1rem;
    line-height: 1.75;
  }
  .article-body > * + * {
    margin-top: 1.25rem;
  }
  .article-body h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: #16233a;
    padding-top: 0.5rem;
  }
  .article-body h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: #16233a;
  }
  .article-body ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .article-body ol {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .article-body li + li {
    margin-top: 0.5rem;
  }
  .article-body strong {
    color: #16233a;
  }
</style>
