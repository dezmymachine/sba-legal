---
import { PRACTICES } from "../data/content";
import LearnMore from "./LearnMore.astro";
---

<section class="bg-white" aria-labelledby="practice-heading">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:py-24">
    <h2
      id="practice-heading"
      class="scroll-reveal font-display t-h2 text-[#16233A]"
    >
      Practice Areas
    </h2>

    <!-- stagger-grid: GSAP cascades each card in sequentially -->
    <div class="stagger-grid mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        PRACTICES.map((p) => (
          <a href={`/expertise/${p.slug}`} class="group block">
            <div class="card-hover overflow-hidden">
              <img
                src={p.image}
                width="900"
                height="1200"
                alt={p.alt}
                loading="lazy"
                class="aspect-[3/4] w-full object-cover"
              />
            </div>
            <h3 class="pt-4 text-left t-card text-[#16233A] group-hover:text-[#07678F]">
              {p.title}
            </h3>
          </a>
        ))
      }
    </div>

    <div class="scroll-reveal mt-8">
      <LearnMore href="/expertise" />
    </div>
  </div>
</section>
