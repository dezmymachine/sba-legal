---
import LearnMore from "./LearnMore.astro";
---

<section class="bg-white" aria-labelledby="about-heading">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24"
  >
    <!-- Text column — each child reveals independently -->
    <div>
      <h2
        id="about-heading"
        class="scroll-reveal font-display text-3xl font-semibold text-[#16233A]"
      >
        About Us
      </h2>
      <p class="scroll-reveal mt-4 text-base leading-relaxed">
        SBA Legal Consult is a law firm based in Kumasi, Ghana. We advise local
        and international clients on matters where law, business and regulation
        meet, and we give advice that is clear, practical and ready to act on.
      </p>
      <div class="scroll-reveal mt-6">
        <LearnMore href="/about" />
      </div>
    </div>

    <!-- Image column -->
    <div class="scroll-reveal">
      <img
        src="/images/about-office.webp"
        width="1200"
        height="801"
        alt="Modern office interior with natural light"
        loading="lazy"
        class="h-64 w-full object-cover lg:h-full"
      />
    </div>
  </div>
</section>
