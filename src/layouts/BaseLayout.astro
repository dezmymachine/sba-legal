---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";

import { firmLd } from "../lib/schema";
import { INDEXABLE } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Extra schema.org nodes for this page (Person, Article, BreadcrumbList…). */
  jsonLd?: Record<string, unknown>[];
  /** Keep this page out of search results (e.g. 404). */
  noindex?: boolean;
}
const {
  title = "SBA Legal Consult | Law Firm in Kumasi, Ghana",
  description = "SBA Legal Consult is a law firm in Kumasi, Ghana, advising on corporate and commercial law, mining, oil and gas, insolvency, property, immigration and disputes.",
  ogImage = "/og-default.jpg",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);
// Social cards need absolute image URLs.
const ogImageURL = new URL(ogImage, site).toString();
const robots = !INDEXABLE || noindex ? "noindex, nofollow" : null;

const graph = {
  "@context": "https://schema.org",
  "@graph": [firmLd(site), ...jsonLd],
};
---

<!doctype html>
<html lang="en-GH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#054A68" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {robots && <meta name="robots" content={robots} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="SBA Legal Consult" />
    <meta property="og:locale" content="en_GH" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Fonts — preconnect first, then non-blocking stylesheet load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="bg-white text-slate-700">
    <Navbar />
    <main><slot /></main>
    <Footer />
    <WhatsAppButton />

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Bail early — CSS already exposes everything for reduced-motion users
      const noMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (!noMotion) {
        // ── Hero entrance (homepage only) ────────────────────────────────────
        const heroHeadline = document.getElementById("hero-headline");
        const heroCta = document.getElementById("hero-cta");
        const heroSlides = document.getElementById("hero-slides");
        const heroSection = document.getElementById("hero-section");

        if (heroHeadline) {
          gsap
            .timeline({ delay: 0.2 })
            .from(heroHeadline, {
              opacity: 0,
              y: 60,
              duration: 1.1,
              ease: "power3.out",
            })
            .from(
              heroCta,
              { opacity: 0, y: 24, duration: 0.8, ease: "power2.out" },
              "-=0.55"
            );
        }

        // ── Hero background parallax ─────────────────────────────────────────
        if (heroSlides && heroSection) {
          gsap.to(heroSlides, {
            yPercent: 28,
            ease: "none",
            scrollTrigger: {
              trigger: heroSection,
              start: "top top",
              end: "bottom top",
              scrub: 0.8,
            },
          });
        }

        // ── Generic scroll reveals (.scroll-reveal) ──────────────────────────
        // Each element gets its own ScrollTrigger so they fire independently
        gsap.utils.toArray<HTMLElement>(".scroll-reveal").forEach((el) => {
          gsap.from(el, {
            opacity: 0,
            y: 48,
            duration: 0.9,
            ease: "power2.out",
            scrollTrigger: {
              trigger: el,
              start: "top 88%",
              toggleActions: "play none none none",
            },
          });
        });

        // ── Staggered grid children (.stagger-grid) ──────────────────────────
        // Children cascade in one-by-one for a premium editorial feel
        gsap.utils.toArray<HTMLElement>(".stagger-grid").forEach((grid) => {
          const items = Array.from(grid.children) as HTMLElement[];
          if (!items.length) return;
          gsap.from(items, {
            opacity: 0,
            y: 44,
            duration: 0.75,
            stagger: 0.13,
            ease: "power2.out",
            scrollTrigger: {
              trigger: grid,
              start: "top 84%",
              toggleActions: "play none none none",
            },
          });
        });
      }
    </script>
  </body>
</html>
